# ==============================================================================
# SMART HEALTH DATA PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Update all placeholder values with your local/production credentials.
# 3. Ensure '.env' remains gitignored and is never committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL DATA WAREHOUSE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_DB=smart_health_dw
POSTGRES_USER=de_admin
POSTGRES_PASSWORD=de_admin_secure_pass_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Role-Based Access Control (RBAC) Passwords (docs/SECURITY_AND_GOVERNANCE.md)
POSTGRES_BI_PASSWORD=bi_reader_secure_pass_2026
POSTGRES_LLM_PASSWORD=llm_agent_secure_pass_2026

# Database Connection URLs (Internal Docker Network)
DATABASE_URL=postgresql://de_admin:de_admin_secure_pass_2026@postgres:5432/smart_health_dw
BI_DATABASE_URL=postgresql://bi_reader:bi_reader_secure_pass_2026@postgres:5432/smart_health_dw
LLM_DATABASE_URL=postgresql://llm_agent:llm_agent_secure_pass_2026@postgres:5432/smart_health_dw

# ------------------------------------------------------------------------------
# 2. MAGE.AI PIPELINE ORCHESTRATOR CONFIGURATION
# ------------------------------------------------------------------------------
MAGE_PORT=6789
MAGE_PROJECT_NAME=smart_health_pipelines

# ------------------------------------------------------------------------------
# 3. SERVING & STREAMLIT DASHBOARD CONFIGURATION
# ------------------------------------------------------------------------------
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# ------------------------------------------------------------------------------
# 4. EXTERNAL DATA APIS & SURVEILLANCE KEYS
# ------------------------------------------------------------------------------
# Open-Meteo ERA5 Reanalysis API (Free tier does not require key, optional for commercial)
OPEN_METEO_API_KEY=

# OpenAQ Air Quality API Key
OPENAQ_API_KEY=

# ------------------------------------------------------------------------------
# 5. AI & LLM PROVIDER API KEYS (FOR TEXT-TO-SQL AGENT)
# ------------------------------------------------------------------------------
# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. LOCAL DATA LAKE STORAGE PATHS
# ------------------------------------------------------------------------------
BRONZE_DATA_PATH=./data/bronze
SILVER_DATA_PATH=./data/silver
GOLD_DATA_PATH=./data/gold
